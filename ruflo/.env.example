# =============================================================
# VEXORA AI - Ruflo Orchestration Engine Configuration
# =============================================================
# Copy this file to .env and fill in your API keys.
# Ruflo will automatically use keys in this priority order:
#   1. OpenRouter  (PRIMARY)
#   2. Google Gemini (SECONDARY)
#   3. Ollama  (LOCAL - optional)
#   4. Anthropic (OPTIONAL fallback)
# =============================================================

# ---- PRIMARY: OpenRouter ----
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Force OpenRouter as the default provider
RUFLO_PROVIDER=openrouter

# Default model when no specific model is chosen
# Recommended: deepseek/deepseek-chat (balanced, cost-efficient)
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

# VEXORA Model Routing (per agent tier)
# haiku tier (fast/cheap) → Gemini Flash
RUFLO_MODEL_HAIKU=google/gemini-2.0-flash-001

# sonnet tier (balanced) → DeepSeek V3 Chat
RUFLO_MODEL_SONNET=deepseek/deepseek-chat

# opus tier (reasoning/architecture) → DeepSeek R1
RUFLO_MODEL_OPUS=deepseek/deepseek-r1

# ---- SECONDARY: Google Gemini ----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model defaults
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-001
GEMINI_PRO_MODEL=gemini-2.5-pro

# ---- LOCAL (Optional): Ollama ----
# For self-hosted models. Set to 'local' for no-auth local Ollama.
# OLLAMA_API_KEY=local
# OLLAMA_BASE_URL=http://localhost:11434

# ---- OPTIONAL: Anthropic ----
# Only needed if you explicitly want Claude models.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================
# Ruflo Runtime Settings
# =============================================================

# Enable trajectory recording for model learning
# CLAUDE_FLOW_ROUTER_TRAJECTORY=1

# Enable model fallback chain on 429/5xx errors
CLAUDE_FLOW_ROUTER_FALLBACK_MAX_RETRIES=2

# Enable neural router for cost-optimal model selection
# CLAUDE_FLOW_ROUTER_NEURAL=1
